# Copiar a .env y completar. .env está en .gitignore: nunca commitear claves.

# Supabase — Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
# Solo para Edge Functions y scripts de servidor. NUNCA en el front.
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago — https://www.mercadopago.com.ar/developers/panel
# Aplicación propia con OAuth (alcance marketplace). Los tokens de cada
# comercio se guardan por comercio en Vault, referenciados desde mp_accounts —
# nunca acá. El redirect_uri no es una variable: se arma en el código como
# `${window.location.origin}/oauth/mercadopago/callback` (ver
# apps/dashboard/src/lib/mercadopago.ts), así funciona igual en local y en
# producción sin tener que duplicar la URL en ningún lado.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Distinto del Client Secret: se genera aparte, en Webhooks → Configure
# Notification dentro de la app de Mercado Pago.
MP_WEBHOOK_SECRET=

# WhatsApp Cloud API — https://developers.facebook.com
# Para desarrollo alcanza con el número de prueba que da Meta.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TEST_PHONE_NUMBER_ID=

# URL pública de la tienda, la que se manda por WhatsApp
SHOP_BASE_URL=https://localhost:5050
