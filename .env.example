# Copiar a .env y completar. .env está en .gitignore: nunca commitear claves.

# Supabase — Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
# Solo para Edge Functions y scripts de servidor. NUNCA en el front.
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago — https://www.mercadopago.com.ar/developers/panel
# Aplicación propia con OAuth. Los tokens de cada comercio se guardan por
# comercio en mp_accounts, no acá.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=
MP_REDIRECT_URI=http://localhost:5173/oauth/mercadopago/callback

# WhatsApp Cloud API — https://developers.facebook.com
# Para desarrollo alcanza con el número de prueba que da Meta.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TEST_PHONE_NUMBER_ID=

# URL pública de la tienda, la que se manda por WhatsApp
SHOP_BASE_URL=http://localhost:5173
