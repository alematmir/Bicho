{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* El alias de vite.config.ts solo lo resuelve el bundler; tsc necesita el
       suyo propio para "tsc -b" del build. Sin baseUrl: deprecado en TS7. */
    "paths": {
      "@bicho/shared": ["../../packages/shared/src/index.ts"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  // Los .test.ts nunca van al build de producción — ver el mismo comentario
  // en apps/admin/tsconfig.app.json.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
