# Copiar a .env.local y completar con los mismos valores del .env de la raíz.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Client ID de la app de Mercado Pago. Es público a propósito (como el de
# cualquier OAuth) — el Client Secret NUNCA va acá, vive solo como secret de
# la Edge Function connect-mercadopago.
VITE_MP_CLIENT_ID=
