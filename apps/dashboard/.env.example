# Copiar a .env.local y completar con los mismos valores del .env de la raíz.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Client ID de la app de Mercado Pago. Es público a propósito (como el de
# cualquier OAuth) — el Client Secret NUNCA va acá, vive solo como secret de
# la Edge Function connect-mercadopago.
VITE_MP_CLIENT_ID=

# Base pública de la tienda, para armar el link que se le muestra al comercio
# en Configuración → Comercio. Sin barra final.
#
# Es de BUILD, no de runtime: cambiarla en Vercel no tiene efecto hasta que se
# vuelve a desplegar.
VITE_SHOP_BASE_URL=https://pedi.bicho.com.ar

# Base pública del portal de cadetes, para armar el link con ?comercio= que
# se le muestra al dueño en Configuración → Usuarios. Mismo criterio que
# VITE_SHOP_BASE_URL: sin barra final, de build.
VITE_DELIVERY_BASE_URL=https://envio.bicho.com.ar
